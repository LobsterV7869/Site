{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/home", "destination": "/" },
    { "source": "/privacy", "destination": "/privacy-policy" },
    { "source": "/terms", "destination": "/terms-of-service" },
    { "source": "/settings", "destination": "/dashboard" },
    { "source": "/roles", "destination": "/dashboard" },
    { "source": "/welcome", "destination": "/dashboard" },
    { "source": "/automod", "destination": "/dashboard" },
    { "source": "/verification", "destination": "/dashboard" },
    { "source": "/logs", "destination": "/dashboard" },
    { "source": "/levels", "destination": "/dashboard" },
    { "source": "/replies", "destination": "/dashboard" },
    { "source": "/security", "destination": "/dashboard" },
    { "source": "/server", "destination": "/dashboard" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https://cdn.discordapp.com data:; connect-src 'self' https:; base-uri 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests" }
      ]
    },
    {
      "source": "/dashboard-config.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    }
  ]
}
